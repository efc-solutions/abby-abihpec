# Copie este arquivo para ".env" e preencha com seus valores reais.
# NUNCA suba o arquivo ".env" (com as chaves de verdade) para o GitHub.
ANTHROPIC_API_KEY=sk-ant-...

# Senha única pra acessar a Abby (tela de "e-mail + senha"). Combine ela com
# quem for divulgar o link.
ACCESS_PASSWORD=defina-uma-senha-forte-aqui

# Senha do painel de administração (editar base de conhecimento).
ADMIN_KEY=defina-outra-senha-forte-aqui

# URL do Apps Script que grava o log de uso (e-mail + tokens) na planilha
# Google — já testada e funcionando, é só usar esse valor mesmo.
SHEETS_WEBHOOK_URL=https://script.google.com/macros/s/AKfycbzekcoT269Gz4tlYd-_16QYi4U8AuMT_s8IJDnBcxOR98YwctW2PhyxtBe788uCRIlU/exec
